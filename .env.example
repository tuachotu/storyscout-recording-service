HOST=0.0.0.0
PORT=3001
WEBAPP_ORIGINS=http://localhost:5173,https://vikrant.info
MAX_AUDIO_BYTES=524288000
AWS_REGION=us-east-1
S3_RECORDING_BUCKET=story-scout-recording-bucket
RECORDING_PREFIX=recordings
PARTICIPANTS_JSON=[{"guid":"replace-with-guid","displayName":"Participant"}]
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters
SESSION_LIFETIME_SECONDS=21600
UPLOAD_URL_SECONDS=900

# Public read-only book reader; defaults to S3_RECORDING_BUCKET when omitted.
S3_BOOK_BUCKET=story-scout-recording-bucket
BOOK_PREFIX=books
