{
  "name": "storyscout-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "StoryScout Record and Transcribe REST API contract",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run tests/app.test.ts tests/recordings.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "contract:lint": "redocly lint openapi/storyscout-v1.yaml",
    "postman:generate": "openapi2postmanv2 -s openapi/storyscout-v1.yaml -o \"postman/StoryScout API.postman_collection.json\" -p -O folderStrategy=Tags,includeAuthInfoInExample=false",
    "postman:validate": "node -e \"JSON.parse(require('node:fs').readFileSync('postman/StoryScout API.postman_collection.json','utf8')); JSON.parse(require('node:fs').readFileSync('postman/StoryScout Local.postman_environment.json','utf8'))\"",
    "contract:check": "npm run contract:lint && npm run postman:validate",
    "check": "npm run contract:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.46.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "newman": "^6.2.2",
    "openapi-to-postmanv2": "^6.3.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.11.3",
    "openai": "^7.4.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
